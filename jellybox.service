[Unit]
Description=JellyBox
After=multi-user.target
# Limit restart attempts so a persistent crash doesn't loop forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jellybox
ExecStart=/usr/bin/python3 /home/pi/jellybox/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
